      "outputs": [],
      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "Seedance 2.5 makes a quick 480p draft. Its **references** carry the draft's task ID, which BytePlus keeps for seven days."
      ],
      "title": "Note"
    },
    {
      "id": 3,
      "type": "MarkdownNote",
