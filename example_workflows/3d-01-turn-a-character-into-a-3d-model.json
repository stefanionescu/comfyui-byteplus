      "outputs": [],
      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "Hyper3D Gen2 turns the image into a 3D model. Its prompt holds Hyper3D's commands for PBR textures and a pose ready for rigging: `--material PBR --TAPose true`. **Save 3D Model** saves it and shows it."
      ],
      "title": "Note"
    },
    {
      "id": 4,
      "type": "MarkdownNote",
      "pos": [
