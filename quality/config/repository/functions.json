{
    "version": 1,
    "python": {
        "max_trivial_statements": 2,
        "verbs": [
            "read",
            "save",
            "send",
            "parse",
            "build",
            "create",
            "choose",
            "list",
            "find",
            "plan",
            "rank",
            "validate",
            "describe",
            "format",
            "get",
            "set",
            "reset",
            "decode",
            "encode",
            "sanitize",
            "wait",
            "register",
            "delete",
            "download",
            "measure",
            "place"
        ],
        "predicates": ["is", "has"],
        "named_paths": ["src/", "scripts/", "__init__.py"],
        "allowlist": [
            {
                "path": "__init__.py",
                "names": ["comfy_entrypoint", "Extension.on_load", "Extension.get_node_list"],
                "reason": "ComfyUI calls these extension hooks itself."
            },
            {
                "path": "src/types/credentials.py",
                "names": ["Credential.reveal"],
                "reason": "Revealing the key is an explicit call at the BytePlus boundary, so no caller reads it by accident."
            },
            {
                "path": "src/settings/routes.py",
                "names": ["ConfigurationRoutes.read_status"],
                "reason": "aiohttp calls this route handler itself."
            },
            {
                "path": "src/byteplus/models.py",
                "names": ["validate_range"],
                "reason": "Video: Generate checks its numbers against the model's row; the Video milestone removes the entry."
            },
            {
                "path": "src/byteplus/operation.py",
                "names": ["measure_encoded_bytes"],
                "reason": "The chat and 3D nodes measure each file against ModelArk's per-file limits; the first of them removes the entry."
            },
            {
                "path": "src/byteplus/references.py",
                "names": ["build_reference_parts", "parse_reference_source"],
                "reason": "Video: Generate orders its references and Reference: Add parses what is typed; each plan removes the name it calls."
            },
            {
                "path": "src/byteplus/transport.py",
                "names": ["send_lookup", "send_task_cancel"],
                "reason": "The task operations and the chat model listing send these requests; each plan removes the names it calls."
            },
            {
                "path": "src/nodes/inputs.py",
                "names": ["encode_media"],
                "reason": "The chat, search, and 3D nodes encode their media lists; the first of them removes the entry."
            }
        ]
    },
    "shell": {
        "max_trivial_statements": 2
    }
}
